# ── 运行时上传的图标（通过管理面板上传，自动生成，不入库） ──
uploads/*
!uploads/.gitkeep

# ── 本地配置：可能含 API Key / 管理密码，切勿上传仓库 ──
# 上传请用 config.example.json 作为模板
config.json

# ── 系统 / 日志 ──
.DS_Store
Thumbs.db
*.log

# ── 依赖：本项目零依赖，无需安装第三方包 ──
node_modules/

# ── 编辑器 / IDE 缓存 ──
.idea/
.vscode/
*.swp

# ── 环境变量 ──
.env
.env.local
